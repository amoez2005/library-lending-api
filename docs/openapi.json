{
  "openapi": "3.1.0",
  "info": {
    "title": "Shelf Library API",
    "description": "Stateless library catalog with HAL links, conditional GET and validated lending transitions. Educational demo; no authentication.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local Shelf application"
    }
  ],
  "tags": [
    {
      "name": "Books",
      "description": "Catalog CRUD and discoverable loan transitions"
    }
  ],
  "paths": {
    "/api/books/{id}": {
      "get": {
        "tags": [
          "Books"
        ],
        "summary": "Get a book (supports If-None-Match and 304)",
        "operationId": "get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/EntityModelBook"
                }
              }
            }
          },
          "304": {
            "description": "Not modified; matching If-None-Match"
          },
          "400": {
            "description": "Invalid request fields or parameters"
          },
          "404": {
            "description": "Book not found"
          }
        }
      },
      "put": {
        "tags": [
          "Books"
        ],
        "summary": "Replace book details; preserve lending state",
        "operationId": "update",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/EntityModelBook"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request fields or parameters"
          },
          "404": {
            "description": "Book not found"
          },
          "409": {
            "description": "Duplicate ISBN, invalid loan state or concurrent update"
          }
        }
      },
      "delete": {
        "tags": [
          "Books"
        ],
        "summary": "Delete an available book",
        "operationId": "delete",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted; no response body"
          },
          "400": {
            "description": "Invalid request fields or parameters"
          },
          "404": {
            "description": "Book not found"
          },
          "409": {
            "description": "Duplicate ISBN, invalid loan state or concurrent update"
          }
        }
      }
    },
    "/api/books": {
      "get": {
        "tags": [
          "Books"
        ],
        "summary": "Search the catalog with zero-based pagination",
        "operationId": "list",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "maxLength": 160,
              "minLength": 0
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0,
              "minimum": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 12,
              "maximum": 100,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/EntityModelMapStringObject"
                }
              }
            }
          },
          "304": {
            "description": "Not modified; matching If-None-Match"
          },
          "400": {
            "description": "Invalid request fields or parameters"
          }
        }
      },
      "post": {
        "tags": [
          "Books"
        ],
        "summary": "Create an available book",
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/EntityModelBook"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request fields or parameters"
          },
          "409": {
            "description": "Duplicate ISBN, invalid loan state or concurrent update"
          }
        }
      }
    },
    "/api/books/{id}/return": {
      "post": {
        "tags": [
          "Books"
        ],
        "summary": "Return a borrowed book",
        "operationId": "returnBook",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/EntityModelBook"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request fields or parameters"
          },
          "404": {
            "description": "Book not found"
          },
          "409": {
            "description": "Duplicate ISBN, invalid loan state or concurrent update"
          }
        }
      }
    },
    "/api/books/{id}/borrow": {
      "post": {
        "tags": [
          "Books"
        ],
        "summary": "Borrow an available book",
        "operationId": "borrow",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/EntityModelBook"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request fields or parameters"
          },
          "404": {
            "description": "Book not found"
          },
          "409": {
            "description": "Duplicate ISBN, invalid loan state or concurrent update"
          }
        }
      }
    },
    "/api": {
      "get": {
        "tags": [
          "api-root-controller"
        ],
        "operationId": "root",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/RepresentationModelObject"
                }
              }
            }
          },
          "304": {
            "description": "Not modified; matching If-None-Match"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BookRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 160,
            "minLength": 0
          },
          "author": {
            "type": "string",
            "maxLength": 120,
            "minLength": 0
          },
          "isbn": {
            "type": "string",
            "minLength": 1,
            "pattern": "[0-9]{13}"
          }
        },
        "required": [
          "author",
          "isbn",
          "title"
        ]
      },
      "EntityModelBook": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "version": {
            "type": "integer",
            "format": "int64"
          },
          "title": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "isbn": {
            "type": "string"
          },
          "borrowed": {
            "type": "boolean"
          },
          "_links": {
            "$ref": "#/components/schemas/Links"
          }
        }
      },
      "RepresentationModelObject": {
        "type": "object",
        "properties": {
          "_links": {
            "$ref": "#/components/schemas/Links"
          }
        }
      },
      "EntityModelMapStringObject": {
        "type": "object",
        "properties": {
          "_links": {
            "$ref": "#/components/schemas/Links"
          }
        }
      },
      "Link": {
        "type": "object",
        "properties": {
          "href": {
            "type": "string"
          },
          "hreflang": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "deprecation": {
            "type": "string"
          },
          "profile": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "templated": {
            "type": "boolean"
          }
        }
      },
      "Links": {
        "type": "object",
        "additionalProperties": {
          "$ref": "#/components/schemas/Link"
        }
      }
    }
  }
}
